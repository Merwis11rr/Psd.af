# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/psd_af_db

# Application Security
SESSION_SECRET=your-very-secure-secret-key-here

# Email Configuration (Optional)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password

# File Upload Configuration
MAX_CONTENT_LENGTH=16777216  # 16MB
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=png,jpg,jpeg,gif,pdf,psd,ai

# WhatsApp Integration
WHATSAPP_NUMBER=+93123456789
WHATSAPP_API_URL=https://api.whatsapp.com/send?phone=

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=GA_MEASUREMENT_ID
GOOGLE_TAG_MANAGER_ID=GTM_CONTAINER_ID

# Social Media
INSTAGRAM_URL=https://instagram.com/psd.af
TWITTER_URL=https://twitter.com/psd_af
TELEGRAM_URL=https://t.me/psd_af

# Development Settings
FLASK_ENV=development
FLASK_DEBUG=True
DEBUG=True

# Production Settings (uncomment for production)
# FLASK_ENV=production
# FLASK_DEBUG=False
# DEBUG=False

# SSL Configuration (for production)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem